[Unit]
Description=Ash Celery Beat (scheduler)
After=network.target redis-server.service celery-worker.service
Requires=redis-server.service

[Service]
Type=simple
User=awais
Group=awais
WorkingDirectory=/home/awais/ash/backend
Environment="DJANGO_SETTINGS_MODULE=ash.settings"
ExecStart=/home/awais/ash/backend/venv/bin/celery -A ash beat --loglevel=info --schedule=/home/awais/ash/backend/celerybeat-schedule
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
